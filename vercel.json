{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/v2/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/v2/esquizz/:path*",
      "destination": "/esquizz/:path*"
    },
    {
      "source": "/v2/media/:path*",
      "destination": "/media/:path*"
    },
    {
      "source": "/v2/images/:path*",
      "destination": "/images/:path*"
    },
    {
      "source": "/v2/_next/:path*",
      "destination": "/_next/:path*"
    },
    {
      "source": "/v2/vireon.css",
      "destination": "/vireon.css"
    },
    {
      "source": "/v2/favicon.ico",
      "destination": "/favicon.ico"
    }
  ]
}
